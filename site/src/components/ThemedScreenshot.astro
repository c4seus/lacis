---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
    light: ImageMetadata;
    dark: ImageMetadata;
    alt: string;
    caption: string;
}

const { light, dark, alt, caption } = Astro.props;
const pictureAttributes = {
    alt,
    formats: ["avif", "webp"],
    fallbackFormat: "webp",
    widths: [720, 1080, 1440, 2160],
    sizes: "(min-width: 72rem) 67.5rem, 100vw",
    loading: "eager",
    decoding: "async",
} as const;
---

<figure class="screenshot">
    <Picture src={light} class="dark:sl-hidden" {...pictureAttributes} />
    <Picture src={dark} class="light:sl-hidden" {...pictureAttributes} />
    <figcaption>{caption}</figcaption>
</figure>

<style>
    .screenshot {
        margin-block: 0 3rem;
    }

    .screenshot :global(img) {
        width: 100%;
        height: auto;
        vertical-align: top;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.75rem;
        box-shadow: var(--sl-shadow-lg);
    }

    figcaption {
        margin-top: 0.75rem;
        color: var(--sl-color-gray-3);
        font-size: var(--sl-text-sm);
        text-align: center;
    }
</style>
